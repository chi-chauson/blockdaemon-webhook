# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Blockdaemon API key — found under JSON-RPC → API Keys in the dashboard
BLOCKDAEMON_API_KEY=your_api_key_here

# Secret you choose when creating the webhook target.
# Must match blockdaemon.webhook.secret in application.properties.
BLOCKDAEMON_WEBHOOK_SECRET=your_webhook_secret_here

# Your Cloudflare tunnel URL (changes every time you restart cloudflared)
TUNNEL_URL=https://your-tunnel-url.trycloudflare.com

# Shared webhook target — one target is reused by every protocol's rule below
TARGET_ID=

# Each protocol has its own address-filter variable + rule
ETH_VARIABLE_ID=
ETH_RULE_ID=
BTC_VARIABLE_ID=
BTC_RULE_ID=
SOL_VARIABLE_ID=
SOL_RULE_ID=
XRP_VARIABLE_ID=
XRP_RULE_ID=

# Ethereum chain-level events (block/reorg) use a separate variable + rule
ETH_CHAIN_VARIABLE_ID=
ETH_CHAIN_RULE_ID=

# Bitcoin utxo_address events (confirmed_input/confirmed_output) reuse BTC_VARIABLE_ID
# — only a new rule is needed, no new variable
BTC_UTXO_RULE_ID=

# Bitcoin chain-level events (block/reorg) use a separate variable + rule
BTC_CHAIN_VARIABLE_ID=
BTC_CHAIN_RULE_ID=

# XRP chain-level events (block only — XRP has no reorg) use a separate variable + rule
XRP_CHAIN_VARIABLE_ID=
XRP_CHAIN_RULE_ID=
